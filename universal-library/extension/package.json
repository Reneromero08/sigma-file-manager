{
  "$schema": "../../packages/api/manifest.schema.json",
  "id": "reneromero08.universal-library",
  "name": "Universal Library",
  "version": "0.4.0",
  "publisher": {
    "name": "Reneromero08",
    "url": "https://github.com/Reneromero08"
  },
  "repository": "https://github.com/Reneromero08/sigma-file-manager",
  "license": "GPL-3.0-or-later",
  "categories": [
    "File Management",
    "Media",
    "Search & Filter",
    "Productivity"
  ],
  "tags": [
    "asset management",
    "collections",
    "creative files",
    "samples",
    "media",
    "linux"
  ],
  "extensionType": "api",
  "main": "src/index.js",
  "permissions": [
    "sidebar",
    "commands",
    "contextMenu",
    "fs.read",
    "notifications",
    "dialogs",
    "clipboard",
    "shell"
  ],
  "activationEvents": [
    "onStartup"
  ],
  "engines": {
    "sigmaFileManager": ">=2.2.0"
  },
  "scripts": {
    "check": "node --check src/index.js && node --check src/catalog-client.js && node --check src/catalog-bridge.js && node --check src/workspace-provider.js && node --check ui/workspace.js",
    "test": "node --test tests/*.node.mjs"
  },
  "type": "module",
  "private": true,
  "binaries": [
    {
      "id": "universal-library-catalog",
      "name": "Universal Library Catalog",
      "version": "0.1.0",
      "executable": "ulib",
      "repository": "https://github.com/Reneromero08/sigma-file-manager",
      "platforms": [
        "linux",
        "windows"
      ],
      "assets": [
        {
          "platform": "linux",
          "arch": [
            "x64"
          ],
          "downloadUrl": "https://github.com/Reneromero08/sigma-file-manager/releases/download/ulib-v0.1.0/ulib-linux-x64.tar.gz",
          "integrity": "sha256:f4c2975a21ee82dc22bdbef925e2e1415346525c8fbdcae7465643246679140f",
          "archive": true,
          "executable": "ulib"
        },
        {
          "platform": "windows",
          "arch": [
            "x64"
          ],
          "downloadUrl": "https://github.com/Reneromero08/sigma-file-manager/releases/download/ulib-v0.1.0/ulib-windows-x64.zip",
          "integrity": "sha256:c664efae59f560767eabe867f88e0a06c8a64e05c6ad59ce10c15c37b43281b7",
          "archive": true,
          "executable": "ulib.exe"
        }
      ]
    }
  ]
}
